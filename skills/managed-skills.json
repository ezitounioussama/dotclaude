{
  "description": "External skill packages that are reinstalled from source (not vendored). The install script uses this manifest to fetch each source and recreate the skill symlinks under ~/.claude/skills.",
  "packages": {
    "gstack": {
      "type": "gstack",
      "repo": "https://github.com/garrytan/gstack.git",
      "binary": "gstack",
      "install_hint": "gstack ships its own installer and manages ~/.claude/skills/gstack + all gstack skill symlinks. Once the `gstack` binary is present, its skills self-register.",
      "skills": [
        "autoplan","benchmark","benchmark-models","browse","canary","careful","codex",
        "connect-chrome","context-restore","context-save","cso","design-consultation",
        "design-html","design-review","design-shotgun","devex-review","diagram",
        "document-generate","document-release","freeze","_gstack-command","gstack-upgrade",
        "guard","health","investigate","ios-clean","ios-design-review","ios-fix","ios-qa",
        "ios-sync","land-and-deploy","landing-report","learn","make-pdf","office-hours",
        "open-gstack-browser","pair-agent","plan-ceo-review","plan-design-review",
        "plan-devex-review","plan-eng-review","plan-tune","qa","qa-only","retro","review",
        "scrape","setup-browser-cookies","setup-deploy","setup-gbrain","ship","skillify",
        "spec","sync-gbrain","unfreeze"
      ]
    },
    "taste-skill": {
      "type": "git-symlink",
      "repo": "https://github.com/Leonxlnx/taste-skill.git",
      "clone_to": "~/.local/share/opencode/taste-skill",
      "install_hint": "Clone the repo, then symlink each installed skill name to the repo's SKILL.md.",
      "skill_map": {
        "brandkit": "skills/brandkit/SKILL.md",
        "design-taste-frontend": "skills/taste-skill/SKILL.md",
        "design-taste-frontend-v1": "skills/taste-skill-v1/SKILL.md",
        "full-output-enforcement": "skills/output-skill/SKILL.md",
        "gpt-taste": "skills/gpt-tasteskill/SKILL.md",
        "high-end-visual-design": "skills/soft-skill/SKILL.md",
        "imagegen-frontend-mobile": "skills/imagegen-frontend-mobile/SKILL.md",
        "imagegen-frontend-web": "skills/imagegen-frontend-web/SKILL.md",
        "image-to-code": "skills/image-to-code-skill/SKILL.md",
        "industrial-brutalist-ui": "skills/brutalist-skill/SKILL.md",
        "minimalist-ui": "skills/minimalist-skill/SKILL.md",
        "redesign-existing-projects": "skills/redesign-skill/SKILL.md",
        "stitch-design-taste": "skills/stitch-skill/SKILL.md"
      }
    },
    "clerk": {
      "type": "agents-symlink",
      "source_dir": "~/.agents/skills",
      "install_hint": "Clerk agent skills live in ~/.agents/skills and are installed via Clerk's agent toolkit (e.g. `npx @clerk/agent-toolkit@latest install` or the clerk CLI). Each installed name is symlinked from ~/.claude/skills/<name> -> ../../.agents/skills/<name>.",
      "skills": [
        "clerk-backend-api","clerk-custom-ui","clerk-nextjs-patterns","clerk-orgs",
        "clerk-react-patterns","clerk-setup","clerk-testing","clerk-webhooks"
      ]
    },
    "claude-seo": {
      "type": "git-installer",
      "repo": "https://github.com/AgriciDaniel/claude-seo",
      "version": "v2.2.0",
      "installer": "curl -fsSL https://raw.githubusercontent.com/AgriciDaniel/claude-seo/v2.2.0/install.sh | bash",
      "install_hint": "Runs claude-seo's own installer, which copies 31 skills into ~/.claude/skills, 18 subagents into ~/.claude/agents, and builds a Python venv at ~/.claude/skills/seo/.venv. Pin the tag with CLAUDE_SEO_TAG=<tag>. Needs python3 >= 3.10 + git. All 8 extensions install by default; each extension's own API keys are configured separately (none are stored in this repo).",
      "skills": [
        "seo","seo-audit","seo-backlinks","seo-cluster","seo-competitor-pages","seo-content",
        "seo-content-brief","seo-dataforseo","seo-drift","seo-ecommerce","seo-flow","seo-geo",
        "seo-google","seo-hreflang","seo-image-gen","seo-images","seo-local","seo-maps",
        "seo-page","seo-plan","seo-programmatic","seo-schema","seo-sitemap","seo-sxo",
        "seo-technical",
        "seo-ahrefs","seo-bing","seo-firecrawl","seo-profound","seo-seranking","seo-unlighthouse"
      ],
      "extensions": [
        "ahrefs","banana","bing-webmaster","dataforseo","firecrawl","profound","seranking","unlighthouse"
      ],
      "agents": [
        "seo-backlinks","seo-cluster","seo-content","seo-dataforseo","seo-drift","seo-ecommerce",
        "seo-flow","seo-geo","seo-google","seo-image-gen","seo-local","seo-maps","seo-performance",
        "seo-schema","seo-sitemap","seo-sxo","seo-technical","seo-visual"
      ]
    },
    "omarchy": {
      "type": "system-symlink",
      "source": "~/.local/share/omarchy/default/omarchy-skill",
      "install_hint": "Provided by the Omarchy desktop install (~/.local/share/omarchy). Symlink ~/.claude/skills/omarchy -> that path.",
      "skills": ["omarchy"]
    }
  }
}
