# Secrets for MCP servers. Copy to `.env` and fill in real values.
# `.env` is git-ignored and never committed.
#
# IMPORTANT: the installers do NOT bake this key into any config file. Every tool
# reads it from the shell ENVIRONMENT at runtime (Claude/opencode/Gemini expand a
# ${VAR} reference; Codex inherits it). So the variable must be exported when you
# launch your AI tool. Easiest options:
#
#   • add `export CONTEXT7_API_KEY=...` to your ~/.bashrc or ~/.zshrc, or
#   • run `set -a; source /path/to/dotclaude/.env; set +a` in your shell.

# Context7 (https://context7.com) — used by the `context7` MCP server everywhere.
CONTEXT7_API_KEY=your-context7-api-key-here
