{
  "chrome-devtools": {
    "type": "stdio",
    "command": "chrome-devtools-mcp",
    "args": [],
    "env": {}
  },
  "magicui": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@magicuidesign/mcp@latest"],
    "env": {}
  },
  "context7": {
    "type": "http",
    "url": "https://mcp.context7.com/mcp",
    "headers": {
      "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
    }
  }
}
